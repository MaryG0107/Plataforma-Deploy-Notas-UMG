<?xml version="1.0" encoding="UTF-8"?>
<!--
  Proxy inverso IIS -> Node.js. Copiá este archivo a la carpeta física del sitio IIS
  (por ejemplo C:\inetpub\sede-central), NO a la carpeta del proyecto.
  Requiere los módulos URL Rewrite y Application Request Routing (ARR) con el proxy habilitado.
  Si cambiás PORT en .env, actualizá 127.0.0.1:3000 en ambas reglas.
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="Node HTTPS" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="^on$" />
          </conditions>
          <serverVariables>
            <set name="HTTP_X_FORWARDED_PROTO" value="https" />
          </serverVariables>
          <action type="Rewrite" url="http://127.0.0.1:3000/{R:1}" />
        </rule>
        <rule name="Node HTTP" stopProcessing="true">
          <match url="(.*)" />
          <serverVariables>
            <set name="HTTP_X_FORWARDED_PROTO" value="http" />
          </serverVariables>
          <action type="Rewrite" url="http://127.0.0.1:3000/{R:1}" />
        </rule>
      </rules>
    </rewrite>
    <security>
      <requestFiltering removeServerHeader="true">
        <!-- 1 MB: la plataforma solo recibe formularios y datos JSON. -->
        <requestLimits maxAllowedContentLength="1048576" />
      </requestFiltering>
    </security>
    <httpErrors existingResponse="PassThrough" />
  </system.webServer>
</configuration>
