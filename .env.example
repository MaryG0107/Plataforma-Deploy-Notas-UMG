# Copiá este archivo como .env y ajustá los valores.

# Dirección y puerto donde escucha Node.js.
# Detrás de IIS dejá 127.0.0.1 (solo accesible desde el propio servidor).
# Para probar directamente por IP en la red, usá 0.0.0.0.
HOST=127.0.0.1
PORT=3000

# Clave para firmar la cookie de sesión (mínimo 32 caracteres aleatorios).
# Generar en PowerShell:
#   -join ((1..48) | ForEach-Object { '{0:x2}' -f (Get-Random -Max 256) })
SESSION_SECRET=

# Cuenta administradora inicial. Solo se usa si la base de datos no tiene usuarios.
# Contraseña de 12 caracteres como mínimo. Después del primer arranque,
# borrá ADMIN_PASSWORD de este archivo y cambiala desde el panel.
ADMIN_USER=admin
ADMIN_PASSWORD=

# Proxy de confianza para leer la IP real y el protocolo (IIS en el mismo equipo = loopback).
TRUST_PROXY=loopback

# true cuando el sitio se publique con HTTPS en IIS (la cookie solo viajará por HTTPS).
COOKIE_SECURE=false

# Duración de la sesión en minutos.
SESSION_MINUTES=120

# Nota mínima (sobre 100) para aprobar un curso. Valor de ejemplo: verificá el reglamento vigente.
NOTA_APROBACION=61

# Ruta del archivo SQLite (relativa a la carpeta del proyecto).
DB_PATH=data/sitio.db
